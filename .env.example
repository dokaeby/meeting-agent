MA_SMTP_PASSWORD=
MA_MAIL_FROM=meetings@example.com
MA_GROQ_KEY=
MA_GROQ_MODEL=llama-3.3-70b-versatile
MA_GROQ_STT_MODEL=whisper-large-v3-turbo
MA_ZOOM_CLIENT_ID=
