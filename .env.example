MA_ENVIRONMENT=development
MA_PROVIDER_MODE=disabled
MA_SECRET_KEY=replace-with-random-48-character-secret
MA_PUBLIC_URL=http://localhost:5173
DB_OWNER_PASSWORD=replace-owner-password
DB_RUNTIME_PASSWORD=replace-runtime-password
MA_DATABASE_URL=postgresql+psycopg://meeting_runtime:replace-runtime-password@localhost:5432/meeting
MA_REDIS_URL=redis://localhost:6379/0
MA_STORAGE_PATH=var/files
MA_SMTP_HOST=localhost
MA_SMTP_PORT=1025
MA_SMTP_STARTTLS=false
